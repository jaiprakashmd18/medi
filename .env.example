# ---------------------------------------------------------------------------
# MEDI-GENIUS backend configuration. Copy to ".env" (never commit .env).
# All values are read by the backend only; nothing here is sent to the browser.
# ---------------------------------------------------------------------------

# --- AI: Claude (cloud) -----------------------------------------------------
# Create a key at https://console.anthropic.com/ . API usage is billed by
# Anthropic separately from Claude.ai Pro/Max subscriptions - a subscription
# does NOT include API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max  (higher = deeper reasoning, more tokens)
ANTHROPIC_EFFORT=high
# Server-side refusal fallback for supported models (recommended)
ANTHROPIC_ENABLE_FALLBACKS=true

# --- AI: Ollama (local) -----------------------------------------------------
# Install from https://ollama.com then:  ollama pull llama3.1:8b  (and llava:7b for diagrams)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b

# Default AI mode for new users: auto | local_only | cloud_only
# (Each user also has to give explicit consent in Settings before any
# document excerpt is sent to the cloud.)
AI_MODE=auto

# --- Local tools ------------------------------------------------------------
# Tesseract OCR (Windows: https://github.com/UB-Mannheim/tesseract/wiki)
# Leave empty if tesseract is on PATH or in C:\Program Files\Tesseract-OCR
TESSERACT_CMD=
TESSERACT_LANG=eng
# LibreOffice is optional; used to render PPTX/DOCX slides exactly. Auto-detected.
SOFFICE_PATH=

# --- Storage & database -----------------------------------------------------
# Relative paths are resolved from the repository root.
DATA_DIR=data
# Leave empty for SQLite in DATA_DIR. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/medigenius
DATABASE_URL=
MAX_UPLOAD_MB=100

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# single_user = personal local app (no login). multi_user = accounts + login.
AUTH_MODE=single_user
# Required for multi_user: a long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
PROCESSING_WORKERS=2
